# ---- copy to backend/.env (local) - NEVER commit real values ----
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL 16 + pgvector >= 0.8
DB_HOST=localhost
DB_PORT=5432
DB_NAME=enterprise_rag
DB_SSLMODE=prefer
DB_APP_USER=rag_app
DB_APP_PASSWORD=change-me-app
DB_WORKER_USER=rag_worker
DB_WORKER_PASSWORD=change-me-worker
DB_READONLY_USER=rag_readonly
DB_READONLY_PASSWORD=change-me-readonly
# migration / bootstrap only - not needed by API or worker processes
DB_MIGRATION_USER=rag_migration
DB_MIGRATION_PASSWORD=change-me-migration
DB_SUPERUSER_DSN=host=localhost port=5432 user=postgres password=postgres dbname=postgres

REDIS_URL=redis://localhost:6379/0
CACHE_BACKEND=redis
CELERY_TASK_ALWAYS_EAGER=false

# Auth: local | oidc | both
AUTH_MODE=both
JWT_SECRET=generate-a-64-char-random-secret-here-0000000000000000000000000
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_HOURS=12
# OIDC_ISSUER=https://login.example.com/tenant/v2.0
# OIDC_AUDIENCE=api://enterprise-rag
# OIDC_JWKS_URL=https://login.example.com/tenant/discovery/v2.0/keys

# Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

STORAGE_ROOT=./var/storage
MALWARE_SCANNER=none          # clamav in staging/production
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
OCR_LANGUAGES=eng
RATE_LIMIT_PER_MINUTE=120
CHAT_RATE_LIMIT_PER_MINUTE=20

# demo seed only
DEMO_PASSWORD=Demo!Passw0rd#2026

# Observability
METRICS_ENABLED=true
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
